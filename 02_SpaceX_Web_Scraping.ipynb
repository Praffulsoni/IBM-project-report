{"cells":[{"cell_type":"markdown","metadata":{},"source":["# SpaceX Web Scraping\n","Wikipedia launch-table collection for the IBM Applied Data Science Capstone.\n","\n","Workflow: HTTP request → BeautifulSoup → identify launch table → parse rows → DataFrame."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import requests\n","from bs4 import BeautifulSoup\n","import pandas as pd\n","\n","url = 'https://en.wikipedia.org/wiki/List_of_Falcon_9_and_Falcon_Heavy_launches'\n","html = requests.get(url, timeout=30).text\n","soup = BeautifulSoup(html, 'html.parser')\n","tables = pd.read_html(str(soup))\n","len(tables)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["launch_tables = [t for t in tables if any('Date' in str(c) or 'Launch date' in str(c) for c in t.columns)]\n","len(launch_tables)"]},{"cell_type":"markdown","metadata":{},"source":["## Result\n","The scraped launch history supplements the API dataset with historical launch attributes."]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"nbformat":4,"nbformat_minor":5}