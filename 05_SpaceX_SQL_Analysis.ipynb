{"cells":[{"cell_type":"markdown","metadata":{},"source":["# SpaceX EDA with SQL\n","SQL aggregation validates launch-site, payload and mission-outcome patterns found during visual EDA."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\n","import sqlite3\n","data = pd.read_csv('dataset_part_1.csv')\n","conn = sqlite3.connect(':memory:')\n","data.to_sql('SPACEXTBL', conn, index=False, if_exists='replace')"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["queries = {\n","    'unique_sites': 'SELECT DISTINCT Launch_Site FROM SPACEXTBL;',\n","    'total_payload': 'SELECT SUM(PAYLOAD_MASS__KG_) AS Total_Payload_Mass FROM SPACEXTBL;',\n","    'min_payload': 'SELECT MIN(PAYLOAD_MASS__KG_) FROM SPACEXTBL;',\n","    'outcomes_by_site': 'SELECT Launch_Site, COUNT(Mission_Outcome) AS MISSION_OUTCOME_COUNT FROM SPACEXTBL GROUP BY Launch_Site;'\n","}\n","results = {k: pd.read_sql_query(v, conn) for k,v in queries.items()}\n","results['unique_sites']"]},{"cell_type":"markdown","metadata":{},"source":["## Queries covered\n","DISTINCT, LIKE, SUM, AVG, MIN, COUNT, GROUP BY and ORDER BY are used for the capstone analytical questions."]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"nbformat":4,"nbformat_minor":5}