{"cells":[{"cell_type":"markdown","metadata":{},"source":["# SpaceX EDA and Data Visualization\n","Explore flight experience, launch site, payload, orbit and landing success relationships."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","data = pd.read_csv('dataset_part_1.csv')"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["sns.catplot(y='LaunchSite', x='FlightNumber', hue='Class', data=data, aspect=1)\n","plt.title('Flight Number vs Launch Site')\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["sns.catplot(y='LaunchSite', x='PayloadMass', hue='Class', data=data, aspect=1)\n","plt.title('Payload Mass vs Launch Site')\n","plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["orbit_success = data.groupby('Orbit')['Class'].mean().sort_values(ascending=False)\n","orbit_success.plot(kind='bar', figsize=(10,4), title='Success Rate by Orbit')\n","plt.ylabel('Success Rate')\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## Findings\n","Flight experience, launch site, payload and orbit provide useful exploratory signals for landing success."]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"nbformat":4,"nbformat_minor":5}